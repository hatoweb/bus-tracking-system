# Copiar a .env en el servidor (NO commitear):
#   cp .env.example .env
#
# Usá los MISMOS host/puerto/usuario/clave que en .env.local de desarrollo.
# Dentro de Docker, 127.0.0.1 NO es PostgreSQL del host.

# --- BD CID (itinerarios / catálogos) ---
DB_CID_HOST=
DB_CID_PORT=5432
DB_CID_USER=
DB_CID_PASSWORD=
DB_CID_NAME=
DB_CID_SSL=false

# --- BD GPS (posiciones de buses) ---
DB_GPS_HOST=
DB_GPS_PORT=5432
DB_GPS_USER=
DB_GPS_PASSWORD=
DB_GPS_NAME=
DB_GPS_SSL=true

# API geo-itinerarios (paradas cercanas / líneas vinculadas)
# Desde Docker en el mismo host: host.docker.internal
# Si geo-itinerarios corre en el host en :8020
GEO_ITINERARIOS_URL=http://host.docker.internal:8020

# --- Login con Google (Gmail) — Auth.js ---
# Generar secreto: openssl rand -base64 32
AUTH_SECRET=
# URL pública completa (con basePath si aplica)
AUTH_URL=https://sistemas.mopc.gov.py/prototipo_vmt
# Credenciales OAuth 2.0 (Google Cloud Console → APIs y servicios → Credenciales)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# En Google Cloud, autorizá:
#   Orígenes: https://sistemas.mopc.gov.py
#   Redirect URI: https://sistemas.mopc.gov.py/prototipo_vmt/api/auth/callback/google
