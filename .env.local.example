# Copiar a .env.local para desarrollo:
#   cp .env.local.example .env.local

# Conexión 1: BBDD_CID (Itinerarios)
DB_CID_HOST=localhost
DB_CID_PORT=5432
DB_CID_USER=tu_usuario
DB_CID_PASSWORD=tu_contraseña
DB_CID_NAME=BBDD_CID
DB_CID_SSL=false

# Conexión 2: BD GPS (Mensajes Operativos / Posiciones)
DB_GPS_HOST=localhost
DB_GPS_PORT=5432
DB_GPS_USER=tu_usuario
DB_GPS_PASSWORD=tu_contraseña
DB_GPS_NAME=nombre_bd_gps
DB_GPS_SSL=false

# API geo-itinerarios (paradas cercanas por proximidad)
GEO_ITINERARIOS_URL=http://127.0.0.1:8020

# --- Login Google (Auth.js) ---
AUTH_SECRET=generar_con_openssl_rand_base64_32
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
